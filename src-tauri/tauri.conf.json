{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rEFInd Switcher",
  "version": "0.1.0",
  "identifier": "com.example.refind-switcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rEFInd 启动切换器",
        "width": 460,
        "height": 680,
        "resizable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
